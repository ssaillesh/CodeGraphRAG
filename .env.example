# App
APP_NAME=AI Codebase Documentation System
ENVIRONMENT=development

# Local paths
WORKSPACE_ROOT=./workspace
REPO_CACHE_DIR=./workspace/repos
INDEX_DIR=./workspace/index
SQLITE_PATH=./workspace/doc_runs.db

# Parsing and chunking
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
MAX_FILE_SIZE_BYTES=1000000

# Models (local-first)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
LLM_MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.3
LLM_DEVICE_MAP=auto

# NVIDIA Llama for codebase descriptions (get key from https://build.nvidia.com/)
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_LLM_MODEL=meta/llama-3.1-70b-instruct

# Vector store
VECTOR_STORE_TYPE=faiss

# Confluence (required for publish=true)
# Use the site root here, not a /wiki/spaces/... page URL.
CONFLUENCE_BASE_URL=https://ssaillesh.atlassian.net
CONFLUENCE_EMAIL=saillesh.somasundaram@gmail.com
CONFLUENCE_API_TOKEN=ATATT3xFfGF0PEVgBntQwdMGjFwgq_8_j_2D_fltwurx5JlEqMUGANqVoFT1_XUxkfmghPAO2y9tFarv2aZiznNHfNxyhNTWkl9MpHf6C5QKd6o40T49g5Lz5ht27UWyB6gmFAvZO9LqKJTM1zH-VJ7iyfBmh0UONId8H7F-5DQyt0mu6_B3BYw=91FCEA58
CONFLUENCE_SPACE_KEY=DOC
CONFLUENCE_ROOT_PAGE_TITLE=AI Generated Codebase Docs

# Celery and Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
